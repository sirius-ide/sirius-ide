rm -f /usr/bin/@@NAME@@

# Uninstall the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database for removed workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# Sirius never adds an apt repository or signing key (see postinst), so there is
# nothing of ours to remove here — and nothing of anyone else's. Upstream's hook
# deleted vscode.sources and microsoft.gpg on the way out; with the debconf
# question it keyed on no longer declared, RET kept its literal "true" and the
# removal ran unconditionally, breaking updates for a real VS Code installed
# beside Sirius.
if [ "$1" = "purge" ] && [ -e '/usr/share/debconf/confmodule' ]; then
	. /usr/share/debconf/confmodule
	db_purge
fi
