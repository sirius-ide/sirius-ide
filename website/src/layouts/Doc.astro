---
/** A repository document on the site: PRIVACY.md, SECURITY.md, ROADMAP.md, LICENSE.txt. */
import Base from './Base.astro';
import { site } from '../site.config';
interface Heading { depth: number; slug: string; text: string }
interface Props { title: string; description: string; eyebrow: string; sourceFile: string; headings?: Heading[]; intro?: string; headline?: string }
const { title, description, eyebrow, sourceFile, headings = [], intro, headline } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={title} description={description}>
	<article class="doc">
		<header class="container doc-head">
			<p class="eyebrow">{eyebrow}</p>
			<h1>{headline ?? title}</h1>
			{intro && <p class="lede">{intro}</p>}
			<p class="source">Rendered from <a href={`${site.github}/blob/sirius/${sourceFile}`} rel="noopener"><code>{sourceFile}</code></a> in the repository, so this page and that file are always the same text.</p>
		</header>
		<div class="container doc-body">
			{toc.length > 2 && (
				<nav class="toc" aria-label="On this page">
					<p class="toc-title">On this page</p>
					<ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
				</nav>
			)}
			<div class="prose"><slot /></div>
		</div>
	</article>
</Base>

<style is:global>
	.doc-head { padding-block: clamp(48px, 7vw, 88px) 1.5rem; }
	.doc-head > * { max-width: 820px; }
	.doc-head h1 { margin-top: 0.75rem; font-size: var(--text-2xl); }
	.doc-head .lede { margin-top: 1rem; }
	.doc-head .source { margin-top: 1.25rem; color: var(--fg-dim); font-size: var(--text-xs); }
	.doc-body { display: grid; grid-template-columns: minmax(0, 820px); gap: 2.5rem; padding-bottom: var(--section-y); }
	.prose hr + hr { display: none; }
	.toc { border: 1px solid var(--border); border-radius: var(--radius-m); padding: 1rem 1.25rem; background: var(--surface); }
	.toc-title { font-family: var(--font-mono); font-variant-ligatures: none; font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-dim); margin-bottom: 0.5rem; }
	.toc ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.3rem; font-size: var(--text-s); }
	.prose { font-size: var(--text-m); line-height: 1.7; color: var(--fg); }
	.prose > * + * { margin-top: 1.1em; }
	.prose h2 { font-size: var(--text-xl); margin-top: 2.2em; padding-top: 1.2em; border-top: 1px solid var(--border); scroll-margin-top: 84px; }
	.prose h3 { font-size: var(--text-l); margin-top: 1.8em; scroll-margin-top: 84px; }
	.prose p, .prose li { color: var(--fg-muted); }
	.prose li { margin-top: 0.35em; }
	.prose strong { color: var(--fg); }
	.prose a { text-decoration: underline; text-underline-offset: 0.18em; }
	.prose pre { padding: 1rem 1.1rem; border-radius: var(--radius-m); border: 1px solid var(--border); background: var(--surface); overflow-x: auto; font-size: var(--text-xs); line-height: 1.65; }
	.prose hr + h2 { border-top: 0; padding-top: 0; margin-top: 1.5rem; }
	.prose pre code { background: none; border: 0; padding: 0; font-size: inherit; color: var(--fg); }
	.prose table { border-collapse: collapse; width: 100%; font-size: var(--text-s); display: block; overflow-x: auto; }
	.prose th, .prose td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
	.prose th { color: var(--fg); font-weight: 600; }
	.prose td { color: var(--fg-muted); }
	.prose blockquote { border-left: 3px solid var(--accent); padding-left: 1rem; color: var(--fg-muted); }
	.prose hr { border: 0; border-top: 1px solid var(--border); }
	.prose pre.license { white-space: pre-wrap; font-family: var(--font-mono); font-variant-ligatures: none; }
	/* roadmap states */
	.prose li.done::marker { content: '✓  '; color: var(--ok); }
	.prose li.todo::marker { content: '○  '; color: var(--fg-dim); }
	.prose li.wip::marker { content: '◐  '; color: var(--warn); }
	.prose li.todo { color: var(--fg-dim); }
	.prose li.todo strong { color: var(--fg-muted); }
	.legend { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; font-size: var(--text-s); color: var(--fg-muted); margin-top: 1.25rem; }
	.legend span::before { margin-right: 0.4em; }
	.legend .done::before { content: '✓'; color: var(--ok); }
	.legend .wip::before { content: '◐'; color: var(--warn); }
	.legend .todo::before { content: '○'; color: var(--fg-dim); }
</style>
