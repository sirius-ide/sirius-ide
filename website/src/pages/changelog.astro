---
import Base from '../layouts/Base.astro';
import { releases, releaseDate, formatSize, cdnUrl, fetchedAt } from '../data/release';
import { site } from '../site.config';
import summaryFile from '../content/changelog.summaries.json';

// One or two user-facing sentences per release, written from the commits between the tags
// (src/content/changelog.summaries.json). A tag without an entry shows its commit list alone.
const summaries = summaryFile as Record<string, string>;
const missing = releases.filter((r) => !summaries[r.tag]).map((r) => r.tag);
if (missing.length) { console.warn(`changelog: no user-facing summary for ${missing.join(', ')} (src/content/changelog.summaries.json)`); }

const isDocs = (s: string) => /^(docs|state|roadmap)(\(|:)/i.test(s) || /^\d+\.\d+\.\d+$/.test(s);
// Release engineering — the pipeline, packaging and CI — is folded under its own line so a release
// made of tooling work reads as exactly that, and user-facing changes come first.
const isEngineering = (s: string) => /^(release|build|ci|chore|update-server|arch|deps?)(\(|:)/i.test(s);
const compareOnly = (body: string) => /^\s*\*\*Full Changelog\*\*:\s*\S+\s*$/.test(body.trim());
const escape = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
const built = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(fetchedAt));
---
<Base title="Changelog" description={`Every Sirius IDE release, newest first — ${releases[0]?.tag} and ${releases.length - 1} before it — with what changed and the assets, generated from GitHub Releases.`}>
	<link slot="head" rel="alternate" type="application/rss+xml" title="Sirius IDE releases" href="/rss.xml" />
	<section class="section">
		<div class="container head">
			<p class="eyebrow">Changelog · {releases.length} releases · <a href="/rss.xml">RSS feed</a></p>
			<h1>What shipped, <span class="muted">release by release.</span></h1>
			<p class="lede">Each release opens with a short summary for people who use Sirius. Below it, generated from GitHub Releases when the site is built (last on {built}), is the technical record: the commits between one tag and the next, with documentation-only commits folded away.</p>
		</div>
		<div class="container list">
			{releases.map((r, i) => {
				const nonDocs = r.commits.filter((c) => !isDocs(c.subject));
				const changes = nonDocs.filter((c) => !isEngineering(c.subject));
				const engineering = nonDocs.filter((c) => isEngineering(c.subject));
				const folded = r.commits.length - nonDocs.length;
				const assets = r.assets.filter((a) => a.name !== 'commit.txt');
				return (
					<article class="release" id={r.tag}>
						<header>
							<h2><a href={`#${r.tag}`}>{r.tag}</a>{i === 0 && !r.prerelease && <span class="tag">latest</span>}{r.prerelease && <span class="tag pre">pre-release</span>}</h2>
							<p class="meta"><time datetime={r.publishedAt}>{releaseDate(r)}</time> · <a href={r.url} rel="noopener">on GitHub</a></p>
						</header>
						{summaries[r.tag] && <p class="summary">{summaries[r.tag]}</p>}
						{r.body && !compareOnly(r.body) && <pre class="notes">{r.body}</pre>}
						{changes.length > 0 && (
							<details class="changes" open={i === 0}>
								<summary>{changes.length} {changes.length === 1 ? 'change' : 'changes'}{folded > 0 && <span class="folded"> · {folded} documentation {folded === 1 ? 'commit' : 'commits'} folded</span>}</summary>
								<ul>{changes.map((c) => <li><code>{c.sha}</code> <span set:html={escape(c.subject)} /></li>)}</ul>
							</details>
						)}
						{engineering.length > 0 && (
							<details class="changes eng">
								<summary>{engineering.length} release-engineering {engineering.length === 1 ? 'commit' : 'commits'}{changes.length === 0 && folded > 0 && <span class="folded"> · {folded} documentation {folded === 1 ? 'commit' : 'commits'} folded</span>}</summary>
								<ul>{engineering.map((c) => <li><code>{c.sha}</code> <span set:html={escape(c.subject)} /></li>)}</ul>
							</details>
						)}
						{changes.length === 0 && engineering.length === 0 && (
							<p class="none">{i === releases.length - 1 ? 'The first release.' : 'Only documentation changed.'}</p>
						)}
						<details class="assets">
							<summary>{assets.length} assets</summary>
							<ul>{assets.map((a) => <li><a href={cdnUrl(r, a, site.downloadHost)}>{a.name}</a> <span class="size">{formatSize(a.size)}</span>{a.sha256 && <code class="sha">{a.sha256}</code>}</li>)}</ul>
						</details>
					</article>
				);
			})}
		</div>
	</section>
</Base>

<style>
	.head > * { max-width: 820px; }
	.head h1 { margin-top: 0.75rem; }
	.head .lede { margin-top: 1rem; }
	.list { margin-top: 2.5rem; display: grid; gap: 1rem; max-width: 820px; }
	.changes li { display: grid; grid-template-columns: auto 1fr; gap: 0 0.6rem; align-items: baseline; }
	.release { padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-l); background: var(--surface); scroll-margin-top: 84px; }
	.release header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
	.release h2 { font-size: var(--text-xl); display: inline-flex; align-items: center; gap: 0.6rem; letter-spacing: 0; font-variant-numeric: tabular-nums; }
	.release h2 a { color: var(--fg); }
	.tag { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2em 0.6em; border-radius: 999px; border: 1px solid var(--accent); color: var(--accent-text); font-weight: 500; }
	.tag.pre { background: var(--surface-3); color: var(--fg-muted); }
	.meta { color: var(--fg-dim); font-size: var(--text-s); }
	.summary { margin-top: 0.9rem; color: var(--fg); font-size: var(--text-m); line-height: 1.55; max-width: 66ch; }
	.notes { margin-top: 1rem; white-space: pre-wrap; font-family: var(--font-sans); font-size: var(--text-s); color: var(--fg-muted); }
	details { margin-top: 1rem; }
	summary { cursor: pointer; font-weight: 600; color: var(--fg); font-size: var(--text-s); }
	summary:hover { color: var(--accent-text); }
	.folded { color: var(--fg-dim); font-weight: 400; }
	details ul { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.45rem; font-size: var(--text-s); color: var(--fg-muted); }
	details li { display: flex; flex-wrap: wrap; gap: 0.3rem 0.6rem; align-items: baseline; }
	details code { font-size: 0.8em; }
	.assets a { font-family: var(--font-mono); font-variant-ligatures: none; font-size: var(--text-xs); }
	.size { font-family: var(--font-mono); font-variant-ligatures: none; font-size: var(--text-xs); color: var(--fg-dim); }
	.sha { flex-basis: 100%; color: var(--fg-dim); font-size: 0.7rem; background: none; border: 0; padding: 0; word-break: break-all; }
	.none { margin-top: 1rem; color: var(--fg-dim); font-size: var(--text-s); }
</style>
