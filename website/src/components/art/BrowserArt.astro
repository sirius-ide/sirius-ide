---
/** Stand-in for the browser-tools footage: the integrated browser beside the agent's tool rows, named as the tools are. */
---
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="art" font-family="var(--font-sans)" font-size="13">
	<rect width="800" height="500" fill="var(--surface)" />
	<rect x="40" y="40" width="460" height="420" rx="10" fill="none" stroke="var(--border-strong)" />
	<rect x="40" y="40" width="460" height="40" rx="10" fill="var(--surface-2)" />
	<rect x="96" y="50" width="380" height="20" rx="10" fill="var(--surface)" stroke="var(--border)" />
	<text x="110" y="64" font-family="var(--font-mono)" font-size="12" fill="var(--fg-muted)">http://localhost:3000/health</text>
	<g fill="var(--fg-dim)"><circle cx="58" cy="60" r="4" /><circle cx="76" cy="60" r="4" /></g>
	<text x="72" y="130" font-family="var(--font-mono)" font-size="15" fill="var(--fg)">{'{'}</text>
	<text x="96" y="158" font-family="var(--font-mono)" font-size="15" fill="var(--fg)"><tspan fill="var(--link)">"ok"</tspan>: <tspan fill="var(--cyan)">true</tspan>,</text>
	<text x="96" y="186" font-family="var(--font-mono)" font-size="15" fill="var(--fg)"><tspan fill="var(--link)">"uptime"</tspan>: <tspan fill="var(--cyan)">4821.37</tspan></text>
	<text x="72" y="214" font-family="var(--font-mono)" font-size="15" fill="var(--fg)">{'}'}</text>
	<rect x="72" y="260" width="180" height="34" rx="6" fill="var(--accent-strong)" />
	<text x="162" y="282" text-anchor="middle" fill="#fff">Retry request</text>
	<rect x="72" y="320" width="396" height="1" fill="var(--border)" />
	<rect x="72" y="340" width="300" height="8" rx="4" fill="var(--fg-dim)" /><rect x="72" y="358" width="240" height="8" rx="4" fill="var(--fg-dim)" />
	<!-- tool rows -->
	<g font-family="var(--font-mono)" font-size="12">
		<rect x="532" y="40" width="228" height="420" rx="10" fill="none" stroke="var(--border-strong)" />
		<text x="548" y="70" font-family="var(--font-sans)" fill="var(--fg)" font-weight="600">Sirius</text>
		<g fill="none" stroke="var(--ok)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m552 100 4 4 8-8" /><path d="m552 134 4 4 8-8" /><path d="m552 168 4 4 8-8" /><path d="m552 202 4 4 8-8" /></g>
		<text x="574" y="104" fill="var(--fg-muted)">open_browser_page</text>
		<text x="574" y="138" fill="var(--fg-muted)">click_element</text>
		<text x="574" y="172" fill="var(--fg-muted)">read_page</text>
		<text x="574" y="206" fill="var(--fg-muted)">screenshot_page</text>
		<rect x="548" y="236" width="196" height="8" rx="4" fill="var(--fg)" /><rect x="548" y="252" width="160" height="8" rx="4" fill="var(--fg)" /><rect x="548" y="268" width="180" height="8" rx="4" fill="var(--fg)" />
		<text x="548" y="320" font-family="var(--font-sans)" fill="var(--fg-dim)">and 34 more, on by default</text>
	</g>
</svg>
<style>.art { background: var(--surface); }</style>
