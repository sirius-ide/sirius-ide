---
/** Stand-in for the git-assist footage: the Source Control view with the commit box filled by the sparkle. */
---
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="art" font-family="var(--font-sans)" font-size="13">
	<rect width="800" height="500" fill="var(--surface)" />
	<rect x="200" y="40" width="400" height="420" rx="10" fill="none" stroke="var(--border-strong)" />
	<text x="220" y="70" fill="var(--fg-muted)" letter-spacing="1" font-size="11">SOURCE CONTROL</text>
	<rect x="220" y="92" width="360" height="74" rx="6" fill="var(--surface-2)" stroke="var(--accent)" />
	<text x="232" y="116" fill="var(--fg)">Rate-limit the health route and log rejections</text>
	<text x="232" y="138" fill="var(--fg-muted)" font-size="12">Add a token bucket in front of /health and warn</text>
	<text x="232" y="156" fill="var(--fg-muted)" font-size="12">on every rejected request.</text>
	<g transform="translate(548 100)"><path d="m8 0 2 5 5 .5-3.9 3.3 1.2 5.2L8 11.3 3.7 14l1.2-5.2L1 5.5 6 5Z" fill="var(--accent)" /></g>
	<rect x="220" y="180" width="360" height="30" rx="6" fill="var(--accent-strong)" />
	<text x="400" y="200" text-anchor="middle" fill="#fff" font-weight="600">Commit</text>
	<text x="220" y="246" fill="var(--fg)" font-weight="600">Changes <tspan fill="var(--fg-muted)" font-weight="400">2</tspan></text>
	<g fill="var(--fg)">
		<text x="236" y="276">health.ts <tspan fill="var(--fg-dim)">src/routes</tspan></text><text x="564" y="276" fill="var(--link)" text-anchor="end">M</text>
		<text x="236" y="304">ratelimit.ts <tspan fill="var(--fg-dim)">src/lib</tspan></text><text x="564" y="304" fill="var(--link)" text-anchor="end">M</text>
	</g>
	<rect x="220" y="340" width="360" height="1" fill="var(--border)" />
	<text x="220" y="376" fill="var(--fg-muted)" font-size="12">Generating commit message…</text>
	<rect x="220" y="392" width="360" height="3" rx="1.5" fill="var(--surface-3)" /><rect x="220" y="392" width="240" height="3" rx="1.5" fill="var(--accent)" />
</svg>
<style>.art { background: var(--surface); }</style>
