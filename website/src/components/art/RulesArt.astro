---
/** Flat drawing: a .siriusrules file open in the editor, and the chat input carrying the current file as context. */
---
<svg xml:space="preserve" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="art" font-family="var(--font-mono)" font-size="14">
	<rect width="800" height="500" fill="var(--surface)" />
	<rect x="40" y="40" width="440" height="420" rx="10" fill="none" stroke="var(--border-strong)" />
	<rect x="40" y="40" width="440" height="34" rx="10" fill="var(--surface-2)" />
	<text x="60" y="62" fill="var(--border-strong)" font-family="var(--font-sans)" font-size="13">.siriusrules</text>
	<g fill="var(--fg-dim)" text-anchor="end"><text x="86" y="112">1</text><text x="86" y="140">2</text><text x="86" y="168">3</text><text x="86" y="196">4</text><text x="86" y="224">5</text><text x="86" y="252">6</text><text x="86" y="280">7</text></g>
	<g fill="var(--border-strong)">
		<text x="104" y="112"><tspan fill="var(--fg-muted)"># aurora — rules for the agent</tspan></text>
		<text x="104" y="140">- Use pnpm, never npm or yarn.</text>
		<text x="104" y="168">- Tests live beside the code: foo.ts → foo.test.ts.</text>
		<text x="104" y="196">- Never log request bodies; log ids.</text>
		<text x="104" y="224">- Public API changes need a note in CHANGELOG.md.</text>
		<text x="104" y="252">- Run `pnpm check` before you say you are done.</text>
		<text x="104" y="280"><tspan fill="var(--fg-dim)">|</tspan></text>
	</g>
	<rect x="40" y="430" width="440" height="30" fill="var(--surface-2)" />
	<rect x="40" y="430" width="34" height="30" fill="var(--accent-strong)" />
	<!-- chat input with the current-file context pill -->
	<rect x="512" y="300" width="248" height="160" rx="10" fill="none" stroke="var(--border-strong)" />
	<rect x="528" y="316" width="116" height="24" rx="12" fill="var(--surface-2)" stroke="var(--border)" />
	<circle cx="542" cy="328" r="4" fill="none" stroke="var(--fg-muted)" stroke-width="1.5" />
	<text x="552" y="332" font-size="12" font-family="var(--font-sans)" fill="var(--border-strong)">health.ts  · current file</text>
	<text x="528" y="378" font-size="13" font-family="var(--font-sans)" fill="var(--fg-dim)">Describe what to build</text>
	<rect x="528" y="412" width="60" height="22" rx="5" fill="var(--surface-2)" stroke="var(--border)" />
	<text x="558" y="427" font-size="12" font-family="var(--font-sans)" fill="var(--border-strong)" text-anchor="middle">Agent</text>
	<rect x="716" y="410" width="28" height="26" rx="5" fill="var(--accent-strong)" />
	<!-- the three rule files -->
	<g font-family="var(--font-sans)" font-size="13" fill="var(--fg-muted)">
		<text x="512" y="70">Read before every request</text>
		<rect x="512" y="88" width="248" height="34" rx="6" fill="var(--surface-2)" stroke="var(--border)" /><text x="526" y="110" fill="var(--border-strong)" font-family="var(--font-mono)">.siriusrules</text>
		<rect x="512" y="130" width="248" height="34" rx="6" fill="var(--surface-2)" stroke="var(--border)" /><text x="526" y="152" fill="var(--border-strong)" font-family="var(--font-mono)">.sirius/rules.md</text>
		<rect x="512" y="172" width="248" height="34" rx="6" fill="var(--surface-2)" stroke="var(--border)" /><text x="526" y="194" fill="var(--border-strong)" font-family="var(--font-mono)">AGENTS.md</text>
	</g>
</svg>
<style>.art { background: var(--surface); }</style>
