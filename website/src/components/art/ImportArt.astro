---
/** Stand-in for the import footage: the "Import settings from which editor?" picker with the real labels and paths. */
---
<svg xml:space="preserve" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="art" font-family="var(--font-sans)" font-size="14">
	<rect width="800" height="500" fill="var(--surface)" />
	<rect x="140" y="90" width="520" height="300" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" />
	<rect x="140" y="90" width="520" height="34" rx="10" fill="var(--surface-3)" />
	<text x="400" y="112" text-anchor="middle" fill="var(--border-strong)">Import settings from which editor?</text>
	<rect x="156" y="138" width="488" height="30" rx="4" fill="var(--surface)" stroke="var(--accent)" />
	<g>
		<rect x="156" y="182" width="488" height="40" rx="4" fill="var(--selection)" />
		<text x="170" y="207" fill="var(--border-strong)">Visual Studio Code <tspan fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="12">  ~/.config/Code/User</tspan></text>
		<text x="170" y="253" fill="var(--border-strong)">Cursor <tspan fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="12">  ~/.config/Cursor/User</tspan></text>
		<text x="170" y="299" fill="var(--border-strong)">Windsurf <tspan fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="12">  ~/.config/Windsurf/User</tspan></text>
		<text x="170" y="345" fill="var(--border-strong)">VSCodium <tspan fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="12">  ~/.config/VSCodium/User</tspan></text>
	</g>
	<g font-size="13" fill="var(--fg-muted)">
		<text x="140" y="430">Then: settings · keybindings · snippets · extensions — pick what comes over.</text>
	</g>
</svg>
<style>.art { background: var(--surface); }</style>
