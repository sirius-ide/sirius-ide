---
/** Stand-in for the remote-server footage: a terminal running the exact steps the release pipeline runs on every host. */
---
<svg xml:space="preserve" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="art" font-family="var(--font-mono)" font-size="14">
	<rect width="800" height="500" fill="var(--surface)" />
	<rect x="40" y="40" width="720" height="420" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" />
	<rect x="40" y="40" width="720" height="32" rx="10" fill="var(--surface-3)" />
	<text x="400" y="61" text-anchor="middle" font-family="var(--font-sans)" font-size="12" fill="var(--fg-muted)">deploy@edge-02 — sirius-server</text>
	<g fill="var(--border-strong)">
		<text x="64" y="112"><tspan fill="var(--ok)">$</tspan> tar -xzf sirius-server-linux-x64.tar.gz --strip-components 1</text>
		<text x="64" y="144"><tspan fill="var(--ok)">$</tspan> bin/helpers/check-requirements.sh</text>
		<text x="64" y="176"><tspan fill="var(--ok)">$</tspan> bin/sirius-server --version</text>
		<text x="64" y="204" fill="var(--fg-muted)">1.118.7</text>
		<text x="64" y="236"><tspan fill="var(--ok)">$</tspan> bin/sirius-server --host 127.0.0.1 --port 8317 \</text>
		<text x="64" y="262">    --accept-server-license-terms --without-connection-token &amp;</text>
		<text x="64" y="300"><tspan fill="var(--ok)">$</tspan> curl -s http://127.0.0.1:8317/version</text>
		<text x="64" y="328" fill="var(--fg-muted)">603044c6cfb3c0b1f9d2a7e5…</text>
		<text x="64" y="372"><tspan fill="var(--ok)">$</tspan> <tspan fill="var(--fg-dim)">█</tspan></text>
	</g>
	<text x="64" y="430" font-family="var(--font-sans)" font-size="13" fill="var(--fg-dim)">x64 and arm64 · glibc 2.28 · the same commit as the editor</text>
</svg>
<style>.art { background: var(--surface); }</style>
