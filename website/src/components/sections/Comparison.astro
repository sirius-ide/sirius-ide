---
import { columns, rows, comparedOn } from '../../data/comparison';
import { site } from '../../site.config';
const sourcesUrl = `${site.github}/blob/sirius/website/src/content/comparison.sources.md`;
const date = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(comparedOn));
---
<section class="section compare" id="compare" aria-labelledby="compare-title">
	<div class="container">
		<div class="section-head">
			<p class="eyebrow">Compared, honestly</p>
			<h2 id="compare-title">Where Sirius stands, <span class="muted">cell by cell.</span></h2>
			<p class="lede">Compared on {date} from each vendor's own pages; every competitor cell has a recorded source, and a cell without one is left blank rather than guessed.</p>
		</div>
		<p class="hint" aria-hidden="true">The table scrolls sideways — seven editors across.</p>
		<div class="scroll" tabindex="0" role="region" aria-label="Comparison table, scrolls sideways">
			<table>
				<thead>
					<tr>
						<th scope="col" class="rowhead"><span class="visually-hidden">Capability</span></th>
						{columns.map((c, i) => <th scope="col" class:list={{ us: i === 0 }}>{c}</th>)}
					</tr>
				</thead>
				<tbody>
					{rows.map((r) => (
						<tr>
							<th scope="row" class="rowhead">{r.label}</th>
							{r.cells.map((cell, i) => (
								<td class:list={{ us: i === 0, good: cell.good, blank: cell.text === '—' }}>
									{cell.text === '—' ? <span aria-label="no source recorded">—</span> : cell.text}
									{cell.source && <a class="src" href={`${sourcesUrl}#${cell.source}`} aria-label={`Source: ${cell.source}`} rel="noopener">†</a>}
								</td>
							))}
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<p class="foot">† Each marked cell is backed by an entry in <a href={sourcesUrl} rel="noopener">comparison.sources.md</a>, with the page it was read from. Competitor names belong to their owners. Tell us where a cell is wrong: <a href={site.issues} rel="noopener">open an issue</a>.</p>
	</div>
</section>

<style>
	.section-head .lede { margin-top: 1rem; }
	.scroll { margin-top: 2.5rem; overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-l); background: var(--surface); }
	.scroll:focus-visible { outline-offset: 2px; }
	/* Seven columns fit a 1200px container at 1440; narrower screens scroll the table sideways. */
	table { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 1040px; font-size: var(--text-xs); }
	th, td { padding: 0.9rem 0.9rem; vertical-align: top; text-align: left; border-bottom: 1px solid var(--border); line-height: 1.5; }
	thead th { font-weight: 600; color: var(--fg); background: var(--surface-2); position: sticky; top: 0; }
	.rowhead { position: sticky; left: 0; background: var(--surface); font-weight: 600; color: var(--fg); min-width: 9.5rem; border-right: 1px solid var(--border); z-index: 1; }
	thead .rowhead { background: var(--surface-2); z-index: 2; }
	td { color: var(--fg-muted); min-width: 7.75rem; }
	.hint { display: none; margin-top: 2rem; margin-bottom: -1.5rem; color: var(--fg-dim); font-size: var(--text-xs); font-family: var(--font-mono); font-variant-ligatures: none; letter-spacing: 0.04em; }
	@media (max-width: 1279px) { .hint { display: block; } }
	td.us { color: var(--fg); background: color-mix(in srgb, var(--accent) 7%, var(--surface)); }
	th.us { color: var(--accent-text); background: color-mix(in srgb, var(--accent) 12%, var(--surface-2)); }
	td.blank { color: var(--fg-dim); }
	tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
	.src { color: var(--accent-text); margin-left: 0.15em; font-size: 0.8em; vertical-align: super; text-decoration: none; padding: 0 0.15em; }
	.src:hover, .src:focus-visible { text-decoration: underline; }
	.foot { margin-top: 1rem; color: var(--fg-dim); font-size: var(--text-xs); line-height: 1.6; max-width: 90ch; }
</style>
