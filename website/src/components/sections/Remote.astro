---
import Feature from './Feature.astro';
import MediaSlot from '../MediaSlot.astro';
import RemoteSurface from '../surfaces/RemoteSurface.astro';
const points = [
	{ lead: 'A floor you can plan on.', html: 'glibc 2.28: Debian 10, RHEL 8 or newer.' },
	{ lead: 'Tested before every release.', html: 'Started on three distributions, x64 and arm64.' },
	{ lead: 'Wired, not yet proven.', html: 'Remote extensions can fetch it; an end-to-end connect is unproven.' },
];
---
<Feature id="remote" eyebrow="08 — Remote server" points={points}>
	<Fragment slot="title">The server half, <span class="muted">shipped with every release.</span></Fragment>
	<Fragment slot="lede">The headless half a remote extension installs on the machine you connect to. Unpack it, run <code>bin/sirius-server</code>, and <code>/version</code> answers.</Fragment>
	<MediaSlot slot="demo" name="remote-server" label="A terminal on a remote host: unpacking the Sirius server tarball, the requirements check, --version, starting the server, and /version answering the release commit."><RemoteSurface /></MediaSlot>
</Feature>
