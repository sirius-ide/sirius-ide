---
import Feature from './Feature.astro';
import MediaSlot from '../MediaSlot.astro';
import TabSurface from '../surfaces/TabSurface.astro';
const points = [
	{ lead: 'Finds your model.', html: 'On <code>auto</code>, a running Ollama code model.' },
	{ lead: 'Next-edit is opt-in.', html: 'Off by default, using the same local model.' },
	{ lead: 'Quiet by design.', html: 'Debounced, cached, cancellable.' },
];
---
<Feature id="tab" eyebrow="02 — Tab and next-edit" points={points}>
	<Fragment slot="title">Completion that runs <span class="muted">on your machine.</span></Fragment>
	<Fragment slot="lede">Fill-in-the-middle completion against a local model you choose, Ollama or llama.cpp. Next-edit prediction offers your next change as a Tab-able diff. No code goes to a cloud.</Fragment>
	<MediaSlot slot="demo" name="tab-completion" label="Tab completion in Sirius: grey ghost text after the caret from a local model, accepted with Tab; then a predicted next edit — a renamed variable's other use marked for replacement — offered inline."><TabSurface /></MediaSlot>
</Feature>
