---
import Feature from './Feature.astro';
import MediaSlot from '../MediaSlot.astro';
import RulesSurface from '../surfaces/RulesSurface.astro';
const points = [
	{ lead: 'Context, no ceremony.', html: 'The file in front of you travels with each request.' },
	{ lead: 'AGENTS.md is shared.', html: 'Other agents read it too.' },
	{ lead: 'Rules never block.', html: 'A missing file is simply skipped.' },
];
---
<Feature id="rules" eyebrow="04 — Project rules and context" points={points}>
	<Fragment slot="title">Your project's rules, <span class="muted">in every request.</span></Fragment>
	<Fragment slot="lede">Put the build commands, the conventions and what never to touch in <code>.siriusrules</code>, <code>.sirius/rules.md</code> or <code>AGENTS.md</code>. Sirius reads it before it answers.</Fragment>
	<MediaSlot slot="demo" name="project-rules" label="A .siriusrules file open in Sirius beside the file being edited, and the chat input carrying that file as context while the agent follows the rules."><RulesSurface /></MediaSlot>
</Feature>
