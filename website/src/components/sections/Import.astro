---
import Feature from './Feature.astro';
import MediaSlot from '../MediaSlot.astro';
import ImportSurface from '../surfaces/ImportSurface.astro';
const points = [
	{ lead: 'It finds what is installed.', html: 'Only editors on this machine are offered.' },
	{ lead: 'Your choice, category by category.', html: 'All four are ticked by default.' },
	{ lead: 'A report, not a shrug.', html: 'Counts, and anything not on Open VSX.' },
];
---
<Feature id="import" eyebrow="07 — Import" flip points={points}>
	<Fragment slot="title">Switch editors. <span class="muted">Bring your setup.</span></Fragment>
	<Fragment slot="lede">One command brings your settings, keybindings, snippets and extensions from Visual Studio Code, Cursor, Windsurf (now Devin Desktop) or VSCodium.</Fragment>
	<MediaSlot slot="demo" name="import" label="The import command in Sirius: choosing the editor to import from, ticking the categories — settings, keybindings, snippets, extensions — and the report it ends with."><ImportSurface /></MediaSlot>
</Feature>
