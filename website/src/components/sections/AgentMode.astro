---
import Feature from './Feature.astro';
import MediaSlot from '../MediaSlot.astro';
import AgentSurface from '../surfaces/AgentSurface.astro';
const points = [
	{ lead: 'Diffs, not surprises.', html: 'Keep or Undo per hunk or per file, with checkpoints to step back to.' },
	{ lead: 'Tools that fit the model.', html: 'Sized in tiers; prompted tools for local models without a tool API.' },
	{ lead: 'Ask, Edit or Agent.', html: 'Your choice per message.' },
];
---
<Feature id="agent" eyebrow="01 — Agent mode" flip points={points}>
	<Fragment slot="title">An agent that works across your files. <span class="muted">You keep the last word.</span></Fragment>
	<Fragment slot="lede">Describe the change. Sirius reads, searches and edits across files and runs what it needs in the terminal.</Fragment>
	<MediaSlot slot="demo" name="agent-mode" label="Sirius in agent mode: a request, the agent's tool runs, and the resulting edits shown as a diff with Keep and Undo controls."><AgentSurface /></MediaSlot>
</Feature>
