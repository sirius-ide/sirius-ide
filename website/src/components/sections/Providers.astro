---
import Feature from './Feature.astro';
import ModelPicker from './ModelPicker.astro';
const hosted = ['Anthropic Claude', 'Google Gemini', 'OpenAI', 'OpenRouter', 'Groq', 'DeepSeek', 'Mistral', 'xAI Grok'];
const local = ['Ollama', 'LM Studio', 'llama.cpp', 'vLLM', 'Any OpenAI-compatible endpoint'];
const points = [
	{ lead: 'Switch in the chat.', html: 'The model picker lists every model you can reach; the status bar shows which is answering.' },
	{ lead: 'Keys stay in the keyring.', html: 'Never <code>settings.json</code>, never synchronised.' },
	{ lead: 'No account, no relay.', html: 'Requests go straight to the provider you chose; a local model never leaves your machine.' },
];
---
<Feature id="models" eyebrow="03 — Bring your own model" flip points={points}>
	<Fragment slot="title">Twelve providers. <span class="muted">No lock-in.</span></Fragment>
	<Fragment slot="lede">Hosted or on your own machine, in one picker.</Fragment>
	<div slot="demo" class="picker"><ModelPicker /></div>
	<div slot="after" class="chips">
		<p><span class="chips-label">Hosted</span> {hosted.map((p) => <span class="chip">{p}</span>)}</p>
		<p><span class="chips-label">Local</span> {local.map((p) => <span class="chip chip-local">{p}</span>)}</p>
	</div>
</Feature>

<style>
	.picker { display: flex; justify-content: center; }
	.chips { margin-top: 1.75rem; display: grid; gap: 0.6rem; }
	.chips p { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
	.chips-label { font-family: var(--font-mono); font-variant-ligatures: none; font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-dim); margin-right: 0.25rem; min-width: 4.5ch; }
	.chip {
		font-size: var(--text-xs); padding: 0.3em 0.7em; border-radius: 999px;
		border: 1px solid var(--border-strong); color: var(--fg-muted); background: var(--surface);
	}
	.chip-local { border-color: color-mix(in srgb, var(--cyan) 45%, var(--border-strong)); color: var(--fg); }
</style>
