---
import ModelPicker from './ModelPicker.astro';
const hosted = ['Anthropic Claude', 'Google Gemini', 'OpenAI', 'OpenRouter', 'Groq', 'DeepSeek', 'Mistral', 'xAI Grok'];
const local = ['Ollama', 'LM Studio', 'llama.cpp', 'vLLM', 'Any OpenAI-compatible endpoint'];
---
<section class="section feature" id="models" aria-labelledby="models-title">
	<div class="container split">
		<div class="copy head">
			<p class="eyebrow">01 — Bring your own model</p>
			<h2 id="models-title">Twelve providers. <span class="muted">No lock-in.</span></h2>
			<p class="lede">
				Anthropic Claude, Google Gemini, OpenAI, OpenRouter, Groq, DeepSeek, Mistral and xAI. Or models on your own
				machine through Ollama, LM Studio, llama.cpp and vLLM — or any OpenAI-compatible endpoint you point it at.
			</p>
		</div>
		<div class="demo">
			<ModelPicker />
		</div>
		<div class="copy more">
			<ul class="points">
				<li>
					<span class="pt-icon" aria-hidden="true"></span>
					<div><b>One keystroke to switch.</b> <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>M</kbd> lists every model your providers offer, and the status bar always shows which one is answering.</div>
				</li>
				<li>
					<span class="pt-icon" aria-hidden="true"></span>
					<div><b>Keys stay in the keyring.</b> libsecret, Keychain or Credential Manager — never <code>settings.json</code>, never synchronised, never sent anywhere but the provider they belong to.</div>
				</li>
				<li>
					<span class="pt-icon" aria-hidden="true"></span>
					<div><b>No account, no relay.</b> Requests go straight from your machine to the provider you chose. With a local model, nothing leaves it at all.</div>
				</li>
			</ul>
			<div class="chips" aria-label="Supported providers">
				<p><span class="chips-label">Hosted</span> {hosted.map((p) => <span class="chip">{p}</span>)}</p>
				<p><span class="chips-label">Local</span> {local.map((p) => <span class="chip chip-local">{p}</span>)}</p>
			</div>
		</div>
	</div>
</section>

<style>
	.feature { position: relative; }
	.split {
		display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); grid-template-areas: "head demo" "more demo";
		column-gap: clamp(2rem, 6vw, 5.5rem); row-gap: 1.75rem; align-items: center;
	}
	.head { grid-area: head; align-self: end; }
	.more { grid-area: more; align-self: start; }
	.demo { grid-area: demo; }
	.copy h2 { margin-top: 1rem; }
	.copy .lede { margin-top: 1.25rem; font-size: var(--text-m); }
	.points { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
	.points li { display: grid; grid-template-columns: 20px 1fr; gap: 0.85rem; align-items: start; color: var(--fg-muted); font-size: var(--text-s); line-height: 1.55; }
	.points b { color: var(--fg); }
	.pt-icon {
		margin-top: 0.35em; width: 20px; height: 20px; border-radius: 50%;
		background:
			linear-gradient(90deg, var(--brand-silver) 0 50%, var(--brand-azure) 50% 100%);
		-webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='m8 1 2 4.6 5 .5-3.8 3.4 1.1 4.9L8 11.9l-4.3 2.5 1.1-4.9L1 6.1l5-.5Z'/></svg>") center / contain no-repeat;
		mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='m8 1 2 4.6 5 .5-3.8 3.4 1.1 4.9L8 11.9l-4.3 2.5 1.1-4.9L1 6.1l5-.5Z'/></svg>") center / contain no-repeat;
	}
	.chips { margin-top: 1.75rem; display: grid; gap: 0.6rem; }
	.chips p { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
	.chips-label { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-dim); margin-right: 0.25rem; min-width: 4.5ch; }
	.chip {
		font-size: var(--text-xs); padding: 0.3em 0.7em; border-radius: 999px;
		border: 1px solid var(--border-strong); color: var(--fg-muted); background: var(--surface);
	}
	.chip-local { border-color: color-mix(in srgb, var(--cyan) 45%, var(--border-strong)); color: var(--fg); }
	.demo { display: flex; justify-content: center; }
	@media (max-width: 900px) {
		.split { grid-template-columns: 1fr; grid-template-areas: "head" "demo" "more"; row-gap: 2.25rem; }
	}
</style>
