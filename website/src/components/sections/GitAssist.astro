---
import Feature from './Feature.astro';
import MediaSlot from '../MediaSlot.astro';
import GitSurface from '../surfaces/GitSurface.astro';
const points = [
	{ lead: 'Into the commit box.', html: 'Staged diff first, working tree if nothing is staged.' },
	{ lead: 'Any model, including local.', html: '' },
	{ lead: 'No model, no mystery.', html: 'It says to add a key or start Ollama.' },
];
---
<Feature id="git" eyebrow="06 — Git assist" points={points}>
	<Fragment slot="title">Commit messages and conflicts, <span class="muted">from the Source Control view.</span></Fragment>
	<Fragment slot="lede">Commit messages come from your diff — a summary under 72 characters, then the why. Merge conflicts go to the agent, which explains each resolution as a diff to review.</Fragment>
	<MediaSlot slot="demo" name="git-assist" label="The Source Control view in Sirius with a generated commit message and two staged files, beside the chat after Resolve Merge Conflicts: the agent's resolution waiting for Keep or Undo."><GitSurface /></MediaSlot>
</Feature>
