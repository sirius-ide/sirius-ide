---
import Feature from './Feature.astro';
import MediaSlot from '../MediaSlot.astro';
import BrowserSurface from '../surfaces/BrowserSurface.astro';
const points = [
	{ lead: 'Read first, look when it helps.', html: '<code>read_page</code> returns the accessibility tree; <code>screenshot_page</code> reaches models that accept images.' },
	{ lead: 'Real Playwright.', html: 'No separate Chrome to install.' },
	{ lead: 'Offered where it fits.', html: 'Small local models are not handed schemas they cannot hold.' },
];
---
<Feature id="browser" eyebrow="05 — Integrated browser" flip points={points}>
	<Fragment slot="title">The agent can see <span class="muted">the page too.</span></Fragment>
	<Fragment slot="lede">A Playwright-backed browser lives in the editor, and the agent gets six tools for it, on by default.</Fragment>
	<MediaSlot slot="demo" name="browser-tools" label="The integrated browser in Sirius showing a local status page, beside the agent's finished tool runs: opened the page, clicked a button, read the page, captured a screenshot."><BrowserSurface /></MediaSlot>
</Feature>
