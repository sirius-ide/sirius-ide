---
import { commands } from './ext';
---
<div class="ref-table ref-table--commands not-content"><table>
	<thead><tr><th>Command Palette title</th><th>Identifier</th></tr></thead>
	<tbody>
		{commands.map((c) => <tr><td>{c.title}</td><td><code>{c.command}</code></td></tr>)}
	</tbody>
</table></div>
