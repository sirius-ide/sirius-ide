---
/**
 * Agent mode, a moment after the hero's: the chat view with the agent's tool runs and the "N files
 * changed" bar beside the editor showing one of the edits as a diff — the removed line, the added
 * lines, and the Keep / Undo hunk control. The strings are the product's own: the progress lines
 * are what sirius-ai's agent prints ("Running <tool name>…", from siriusAgent.ts), the controls
 * are the workbench's chat-editing actions.
 */
import Surface from './Surface.astro';
import Icon from '../hero/Icon.astro';
---
<Surface class="agent-s">
	<div class="grid">
		<div class="sx-chat">
			<div class="sx-chat-head"><span>Chat</span><span class="acts"><Icon name="plus" size={15} /><Icon name="history" size={15} /><Icon name="more" size={15} /></span></div>
			<div class="sx-log">
				<div class="sx-turn">
					<span class="sx-av"><Icon name="person" size={13} /></span>
					<div class="sx-bubble">Send a Retry-After header on the 429 and add a test.</div>
				</div>
				<div class="sx-ai">
					<div class="sx-who"><span class="sx-av ai"><Icon name="star" size={12} /></span> Sirius</div>
					<ul class="sx-prog">
						<li><Icon name="check" size={14} class="ok" /><span>Running read file…</span></li>
						<li><Icon name="check" size={14} class="ok" /><span>Running edit file…</span></li>
						<li><Icon name="check" size={14} class="ok" /><span>Running create file…</span></li>
						<li><Icon name="check" size={14} class="ok" /><span>Running run in terminal…</span></li>
					</ul>
					<p class="sx-prose">Added <code>retryAfter()</code> to the bucket, sent it as a <code>Retry-After</code> header and covered it in <code>health.test.ts</code>. The tests pass.</p>
					<ul class="sx-pills">
						<li><i class="sx-fi">TS</i> health.ts <b>+3</b> <i>−1</i></li>
						<li><i class="sx-fi">TS</i> ratelimit.ts <b>+4</b></li>
						<li><i class="sx-fi">TS</i> health.test.ts <b>+14</b></li>
					</ul>
				</div>
				<div class="sx-changed"><span class="cnt">3 files changed</span><span class="sx-kbtn keep">Keep All Edits</span><span class="sx-kbtn undo">Undo All Edits</span></div>
			</div>
		</div>

		<div class="ed">
			<div class="sx-tabs">
				<div class="sx-tab on mod"><i class="sx-fi">TS</i><span class="nm">health.ts</span><span class="x"><Icon name="close" size={12} /></span></div>
				<div class="sx-tab mod"><i class="sx-fi">TS</i><span class="nm">ratelimit.ts</span></div>
				<div class="sx-tab"><i class="sx-fi">TS</i><span class="nm">health.test.ts</span></div>
			</div>
			<div class="sx-code">
				<div class="sx-hunk"><span class="sx-hb"><Icon name="arrowUp" size={13} /></span><span class="sx-hb"><Icon name="arrowDown" size={13} /></span><span class="sx-hsep"></span><span class="sx-hb">Keep</span><span class="sx-hb">Undo</span></div>
				<div class="sx-row"><span class="sx-ln">8</span><span class="sx-src"><b class="v">router</b><b class="p">.</b><b class="f">get</b><b class="p">(</b><b class="s">'/health'</b><b class="p">, (</b><b class="v">req</b><b class="p">,</b> <b class="v">res</b><b class="p">)</b> <b class="k">=&gt;</b> <b class="p">{'{'}</b></span></div>
				<div class="sx-row"><span class="sx-ln">9</span><span class="sx-src">  <b class="k">if</b> <b class="p">(!</b><b class="v">bucket</b><b class="p">.</b><b class="f">take</b><b class="p">(</b><b class="v">req</b><b class="p">.</b><b class="v">ip</b><b class="p">)) {'{'}</b></span></div>
				<div class="sx-row del"><span class="sx-ln"></span><span class="sx-src">    <b class="k">return</b> <b class="v">res</b><b class="p">.</b><b class="f">status</b><b class="p">(</b><b class="n">429</b><b class="p">).</b><b class="f">end</b><b class="p">();</b></span></div>
				<div class="sx-row add"><span class="sx-ln">10</span><span class="sx-src">    <b class="k2">const</b> <b class="v">wait</b> <b class="p">=</b> <b class="v">bucket</b><b class="p">.</b><b class="f">retryAfter</b><b class="p">();</b></span></div>
				<div class="sx-row add"><span class="sx-ln">11</span><span class="sx-src">    <b class="v">res</b><b class="p">.</b><b class="f">set</b><b class="p">(</b><b class="s">'Retry-After'</b><b class="p">,</b> <b class="t">String</b><b class="p">(</b><b class="v">wait</b><b class="p">));</b></span></div>
				<div class="sx-row add"><span class="sx-ln">12</span><span class="sx-src">    <b class="k">return</b> <b class="v">res</b><b class="p">.</b><b class="f">status</b><b class="p">(</b><b class="n">429</b><b class="p">).</b><b class="f">json</b><b class="p">({'{'}</b> <b class="v">wait</b> <b class="p">{'}'});</b></span></div>
				<div class="sx-row"><span class="sx-ln">13</span><span class="sx-src">  <b class="p">{'}'}</b></span></div>
				<div class="sx-row"><span class="sx-ln">14</span><span class="sx-src">  <b class="v">res</b><b class="p">.</b><b class="f">json</b><b class="p">({'{'}</b> <b class="v">ok</b><b class="p">:</b> <b class="n">true</b> <b class="p">{'}'});</b></span></div>
				<div class="sx-row"><span class="sx-ln">15</span><span class="sx-src"><b class="p">{'}'});</b></span></div>
			</div>
		</div>
	</div>
</Surface>

<style>
	.grid { display: grid; grid-template-columns: minmax(0, 38fr) minmax(0, 62fr); min-height: 21em; }
	.sx-chat { border-right: 1px solid var(--w-border); }
	.ed { min-width: 0; display: flex; flex-direction: column; background: var(--w-bg); }
	.sx-code { flex: 1; }
	.sx-hunk { top: calc(0.35em + 1.6em * 1 - 0.15em); }
	.sx-code { font-size: 0.88em; }
	.sx-log { flex: 1; }
	.sx-changed { margin-top: auto; }
	/* the diff needs room for its lines and the hunk control: below this the chat sits above it */
	@container sx (max-width: 560px) {
		.grid { grid-template-columns: minmax(0, 1fr); min-height: 0; }
		.sx-chat { border-right: 0; border-bottom: 1px solid var(--w-border); }
	}
	@container sx (max-width: 470px) { .sx-tab:nth-child(3) { display: none; } }
</style>
