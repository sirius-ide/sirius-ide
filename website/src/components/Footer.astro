---
import Logo from './Logo.astro';
import { site } from '../site.config';
const year = new Date().getUTCFullYear();
const groups: Array<{ title: string; links: Array<[string, string]> }> = [
	{ title: 'Product', links: [['Download', '/download/'], ['Docs', '/docs/'], ['Changelog', '/changelog/'], ['Roadmap', '/roadmap/']] },
	{ title: 'Project', links: [['GitHub', site.github], ['Issues', site.issues], ['Security', '/security/']] },
	{ title: 'Legal', links: [['Privacy', '/privacy/'], ['Licence', '/license/']] },
];
---
<footer class="footer">
	<div class="container">
		<div class="grid">
			<div class="brand-col">
				<a class="brand" href="/" aria-label="Sirius IDE — home"><Logo size={28} /><span>Sirius IDE</span></a>
				<p class="tag">{site.tagline}</p>
			</div>
			{groups.map((g) => (
				<nav aria-label={g.title}>
					<h2>{g.title}</h2>
					<ul>{g.links.map(([label, href]) => <li><a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a></li>)}</ul>
				</nav>
			))}
		</div>
		<div class="theme" data-theme-control hidden>
			<label for="theme-select">Theme</label>
			<select id="theme-select" name="theme" autocomplete="off">
				<option value="auto">System</option>
				<option value="light">Light</option>
				<option value="dark">Dark</option>
			</select>
		</div>
		<p class="legal"><span>
			© {year} Sirius IDE. Sirius IDE is a derivative work of Code - OSS, which is MIT-licensed and
			copyright Microsoft Corporation. It is not Visual Studio Code and is neither produced nor endorsed by
			Microsoft. Provider and product names belong to their owners.
		</span></p>
	</div>
</footer>
<script>
	// The same localStorage key and values Starlight's own theme switch uses on /docs/, so one
	// choice holds across the whole site. Hidden until JavaScript runs: without it the OS decides.
	const KEY = 'starlight-theme';
	function apply(value: string) {
		const root = document.documentElement;
		if (value === 'light' || value === 'dark') { root.dataset.theme = value; } else { delete root.dataset.theme; }
	}
	function init() {
		const wrap = document.querySelector<HTMLElement>('[data-theme-control]');
		const select = wrap?.querySelector<HTMLSelectElement>('select');
		if (!wrap || !select) { return; }
		let stored = 'auto';
		try { stored = localStorage.getItem(KEY) ?? 'auto'; } catch { /* storage may be blocked */ }
		select.value = stored === 'light' || stored === 'dark' ? stored : 'auto';
		wrap.hidden = false;
		select.addEventListener('change', () => {
			try { localStorage.setItem(KEY, select.value); } catch { /* ignore */ }
			apply(select.value);
		});
	}
	init();
</script>

<style>
	.footer { border-top: 1px solid var(--border); padding-block: 3.5rem 2.5rem; background: var(--surface); }
	.grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2rem; }
	.brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--fg); font-weight: 700; letter-spacing: -0.02em; }
	.brand:hover { text-decoration: none; color: var(--fg); }
	.tag { margin-top: 0.9rem; color: var(--fg-muted); font-size: var(--text-s); max-width: 28ch; }
	h2 { font-family: var(--font-mono); font-variant-ligatures: none; font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-dim); margin-bottom: 0.9rem; }
	ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
	li a { color: var(--fg-muted); font-size: var(--text-s); }
	li a:hover { color: var(--fg); }
	.theme { margin-top: 2.5rem; display: flex; align-items: center; gap: 0.6rem; font-size: var(--text-xs); color: var(--fg-dim); }
	.theme select { font: inherit; color: var(--fg-muted); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-s); padding: 0.3rem 0.5rem; }
	.legal { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--fg-dim); font-size: var(--text-xs); line-height: 1.6; }
	.legal span { display: block; max-width: 90ch; }
	@media (max-width: 760px) {
		.grid { grid-template-columns: 1fr 1fr; }
		.brand-col { grid-column: 1 / -1; }
	}
</style>
