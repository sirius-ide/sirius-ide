---
import Logo from './Logo.astro';
import { site } from '../site.config';
const year = new Date().getUTCFullYear();
const groups: Array<{ title: string; links: Array<[string, string]> }> = [
	{ title: 'Product', links: [['Download', '/download/'], ['Docs', '/docs/'], ['Changelog', '/changelog/'], ['Roadmap', '/roadmap/']] },
	{ title: 'Project', links: [['GitHub', site.github], ['Issues', site.issues], ['Security', '/security/']] },
	{ title: 'Legal', links: [['Privacy', '/privacy/'], ['Licence', '/license/']] },
];
---
<footer class="footer">
	<div class="container">
		<div class="grid">
			<div class="brand-col">
				<a class="brand" href="/" aria-label="Sirius IDE — home"><Logo size={28} /><span>Sirius IDE</span></a>
				<p class="tag">{site.tagline}</p>
				<p class="by">By {site.company}</p>
			</div>
			{groups.map((g) => (
				<nav aria-label={g.title}>
					<h2>{g.title}</h2>
					<ul>{g.links.map(([label, href]) => <li><a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a></li>)}</ul>
				</nav>
			))}
		</div>
		<p class="legal">
			© {year} {site.company} Sirius IDE is a derivative work of Code - OSS, which is MIT-licensed and
			copyright Microsoft Corporation. It is not Visual Studio Code and is neither produced nor endorsed by
			Microsoft. Provider and product names belong to their owners.
		</p>
	</div>
</footer>

<style>
	.footer { border-top: 1px solid var(--border); padding-block: 3.5rem 2.5rem; background: var(--surface); }
	.grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2rem; }
	.brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--fg); font-weight: 700; letter-spacing: -0.02em; }
	.brand:hover { text-decoration: none; color: var(--fg); }
	.tag { margin-top: 0.9rem; color: var(--fg-muted); font-size: var(--text-s); max-width: 28ch; }
	.by { margin-top: 0.4rem; color: var(--fg-dim); font-size: var(--text-xs); }
	h2 { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-dim); margin-bottom: 0.9rem; }
	ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
	li a { color: var(--fg-muted); font-size: var(--text-s); }
	li a:hover { color: var(--fg); }
	.legal { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--fg-dim); font-size: var(--text-xs); line-height: 1.6; max-width: 90ch; }
	@media (max-width: 760px) {
		.grid { grid-template-columns: 1fr 1fr; }
		.brand-col { grid-column: 1 / -1; }
	}
</style>
